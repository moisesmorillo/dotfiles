{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-5.5",
  "small_model": "openai/gpt-5.4-mini-fast",
  "autoupdate": false,
  "instructions": [
    "CLAUDE.md",
    "GEMINI.md"
  ],
  "default_agent": "plan",
  "agent": {
    "build": {
      "model": "openai/gpt-5.5"
    },
    "plan": {
      "model": "openai/gpt-5.5"
    }
  },
  "mcp": {
    "context7": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@upstash/context7-mcp",
        "--api-key",
        "{env:CONTEX7_API_KEY}"
      ],
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "@playwright/mcp@latest"
      ],
      "enabled": true
    },
    "linear": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "mcp-remote",
        "https://mcp.linear.app/mcp"
      ],
      "enabled": true
    }
  },
  "plugin": [
    "@franlol/opencode-md-table-formatter@latest",
    "opencode-smart-voice-notify@latest",
    "@tarquinen/opencode-dcp@latest",
    "opencode-openai-codex-auth",
    "oh-my-openagent@latest"
  ],
  "provider": {
    "local-omlx": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local oMLX",
      "options": {
        "baseURL": "http://127.0.0.1:8000/v1",
        "apiKey": "{env:LOCAL_OMLX_API_KEY}"
      },
      "models": {
        "local-general:general-128k": {
          "name": "General — Qwen35 (128K)",
          "limit": { "context": 131072, "output": 2048 }
        },
        "local-general:coding-256k": {
          "name": "Coding — Qwen35 (256K experimental)",
          "limit": { "context": 262144, "output": 2048 }
        },
        "gemma-4-26B-A4B-it-qat-4bit:experimental-128k": {
          "name": "Experimental — Gemma 4 26B (128K)",
          "limit": { "context": 131072, "output": 2048 }
        }
      }
    }
  },
  "enabled_providers": [
    "openai",
    "local-omlx"
  ]
}
