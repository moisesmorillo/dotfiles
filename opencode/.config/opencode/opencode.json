{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-6-luna",
  "small_model": "openai/gpt-6-luna",
  "autoupdate": false,
  "skills": [
    "~/workspace/moisesmorillo/ai-engineering/skills"
  ],
  "instructions": [
    "CLAUDE.md",
    "GEMINI.md"
  ],
  "default_agent": "plan",
  "agent": {
    "build": {
      "model": "openai/gpt-6-luna",
      "variant": "xhigh"
    },
    "plan": {
      "model": "openai/gpt-6-sol",
      "variant": "medium"
    },
    "title": {
      "model": "openai/gpt-6-luna",
      "variant": "low"
    },
    "code-review-sol": {
      "description": "Review code with the ai-engineering code-review skill using GPT-6 Sol medium",
      "mode": "subagent",
      "model": "openai/gpt-6-sol",
      "variant": "medium",
      "permission": {
        "edit": "deny"
      },
      "prompt": "Load and follow the code-review skill with the skill tool before reviewing. Report findings with file and line references. Do not modify files."
    },
    "design-review-sol": {
      "description": "Review designs with the ai-engineering design-feasibility-review skill using GPT-6 Sol medium",
      "mode": "subagent",
      "model": "openai/gpt-6-sol",
      "variant": "medium",
      "permission": {
        "edit": "deny"
      },
      "prompt": "Load and follow the design-feasibility-review skill with the skill tool before reviewing. Report findings with document references. Do not modify files."
    }
  },
  "mcp": {
    "context7": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@upstash/context7-mcp",
        "--api-key",
        "{env:CONTEX7_API_KEY}"
      ],
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "@playwright/mcp@latest"
      ],
      "enabled": true
    },
    "linear": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "mcp-remote",
        "https://mcp.linear.app/mcp"
      ],
      "enabled": true
    }
  },
  "plugin": [
    "@franlol/opencode-md-table-formatter@latest",
    "opencode-smart-voice-notify@latest",
    "@tarquinen/opencode-dcp@latest",
    "opencode-openai-codex-auth"
  ],
  "provider": {
    "local-omlx": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local oMLX",
      "options": {
        "baseURL": "http://127.0.0.1:8000/v1"
      },
      "models": {
        "local-general:general-128k": {
          "name": "General — Qwen35 (128K)",
          "limit": { "context": 131072, "output": 2048 }
        },
        "local-general:coding-256k": {
          "name": "Coding — Qwen35 (256K experimental)",
          "limit": { "context": 262144, "output": 4096 }
        },
        "experimental-qwen38:coding-128k": {
          "name": "Experimental — Qwen3.8 27B (128K)",
          "limit": { "context": 131072, "output": 2048 }
        },
        "experimental-qwen38:coding-128k-baseline": {
          "name": "Experimental — Qwen3.8 27B Baseline (128K)",
          "limit": { "context": 131072, "output": 4096 }
        },
        "experimental-qwen38-mtp:coding-128k-mtp": {
          "name": "Experimental — Qwen3.8 27B Native MTP (128K)",
          "limit": { "context": 131072, "output": 4096 }
        }
      }
    }
  },
  "enabled_providers": [
    "openai",
    "local-omlx"
  ]
}
