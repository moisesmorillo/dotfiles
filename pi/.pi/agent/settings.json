{
  "defaultModel": "gpt-6.1-sol",
  "defaultProvider": "openai",
  "defaultThinkingLevel": "medium",
  "modelThinkingLevels": {
    "openai/gpt-6.1-sol": "medium",
    "openai/gpt-6-luna": "medium"
  },
  "subagents": {
    "defaultModel": "openai/gpt-6-luna",
    "defaultThinking": "medium",
    "agentOverrides": {
      "reviewer": {
        "thinking": "high"
      },
      "oracle": {
        "thinking": "high"
      },
      "worker": {
        "thinking": "medium"
      }
    }
  },
  "npmCommand": [
    "mise",
    "exec",
    "node@24.21.0",
    "--",
    "npm"
  ],
  "packages": [
    "npm:pi-web-access",
    "npm:pi-subagents",
    "npm:pi-background-tasks",
    "npm:pi-btw",
    "git:github.com/obra/superpowers",
    "npm:gentle-engram",
    "npm:@narumitw/pi-worktree",
    "npm:pi-powerline-footer",
    "npm:@juicesharp/rpiv-ask-user-question",
    "npm:pi-lens",
    "npm:cc-safety-net",
    "npm:@pi-unipi/notify",
    "npm:@plannotator/pi-extension",
    "npm:agent-ste",
    "npm:pi-token-speed"
  ],
  "skills": [
    "~/workspace/moisesmorillo/ai-engineering/skills"
  ],
  "theme": "rose-pine",
  "tuiMode": "fullscreen",
  "lastChangelogVersion": "1.1.0",
  "powerline": {
    "preset": "full",
    "placement": "below",
    "disabledSegments": [
      "hostname",
      "subagents",
      "token_in",
      "token_out",
      "cache_read",
      "time",
      "cost"
    ],
    "secondaryOverflow": "wrap",
    "customItems": [
      {
        "id": "tps",
        "statusKey": "tokenSpeed",
        "position": "right",
        "selfColorize": true
      }
    ]
  },
  "tokenSpeed": {
    "display": "full",
    "useProviderTokens": true,
    "slidingWindow": 1000
  },
  "showLastPrompt": false
}
