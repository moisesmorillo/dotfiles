# Let other environments own pi's settings.json without breaking this package.
# Some sandboxes write ~/.pi/agent/settings.json themselves before stow runs; stow
# cannot overlay a pre-existing real file, so it would abort the whole `pi` package
# on that conflict and never link themes/. Ignore settings.json so stow still lays
# down themes/ (and anything else this package ships) while leaving an
# externally-managed settings.json alone.
\.pi/agent/settings\.json
\.pi/agent/(sessions|missions|npm|git|web-search-cache|pi-subagents|pi-pretty)(/|$)
\.pi/agent/(auth\.json|models\.json|models-store\.json|run-history\.jsonl)
\.pi/agent/(mcp\.log|mcp-auth\.json)
\.pi/agent/.*\.bak
\.pi/web-search-cache/
\.config/pi/settings\.json
