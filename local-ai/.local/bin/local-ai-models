#!/usr/bin/env zsh
# Download declared local models without storing weights in the dotfiles repo.
set -euo pipefail

typeset config_dir="${LOCAL_AI_CONFIG_DIR:-$HOME/.config/local-ai}"
typeset manifest="$config_dir/omlx/models.json"
typeset provider="${LOCAL_AI_MODEL_PROVIDER:-omlx}"
typeset action=""
typeset selection=""

if [[ ! -f "$manifest" ]]; then
  print -u2 "Local AI model catalogue missing: $manifest"
  exit 1
fi

usage() {
  print 'Usage: local-ai-models [--provider PROVIDER] {list|download|dry-run|configure} [MODEL|TIER]'
  print 'Examples:'
  print '  local-ai-models list --provider omlx'
  print '  local-ai-models download core'
  print '  local-ai-models configure --provider omlx'
  print '  local-ai-models --provider llama.cpp dry-run <model-id>'
}

while (( $# )); do
  case "$1" in
    --provider)
      (( $# >= 2 )) || { usage; exit 2; }
      provider="$2"
      shift 2
      ;;
    --provider=*)
      provider="${1#--provider=}"
      shift
      ;;
    list|download|dry-run|configure)
      [[ -z "$action" ]] || { usage; exit 2; }
      action="$1"
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      [[ -z "$selection" ]] || { usage; exit 2; }
      selection="$1"
      shift
      ;;
  esac
done

action="${action:-list}"
if ! jq -e --arg provider "$provider" '.providers[$provider]' "$manifest" >/dev/null; then
  print -u2 "Unknown provider: $provider"
  print -u2 "Available providers: $(jq -r '.providers | keys | join(", ")' "$manifest")"
  exit 2
fi

typeset storage_root provider_dir model_dir
storage_root="$(jq -r '.storage_root' "$manifest")"
storage_root="${storage_root/#\~/$HOME}"
provider_dir="$(jq -r --arg provider "$provider" '.providers[$provider].directory' "$manifest")"
model_dir="${LOCAL_AI_MODEL_DIR:-$storage_root/$provider_dir}"

select_models() {
  local selector="$1"
  jq -c --arg provider "$provider" --arg selector "$selector" \
    '.models[] | select(.provider == $provider and (.id == $selector or .tier == $selector))' \
    "$manifest"
}

configure_omlx() {
  local omlx_dir="${OMLX_BASE_PATH:-$HOME/.omlx}"
  local settings_file="$omlx_dir/settings.json"
  local profiles_template="$config_dir/omlx/model-profiles.json"
  local model_settings_template="$config_dir/omlx/model-settings.json"
  local profiles_file="$omlx_dir/model_profiles.json"
  local model_settings_file="$omlx_dir/model_settings.json"
  local timestamp="$(date '+%Y%m%d%H%M%S')"
  local temporary

  if [[ ! -f "$settings_file" ]]; then
    print -u2 "oMLX settings are not initialized: $settings_file"
    print -u2 'Start oMLX once, then rerun this command.'
    exit 1
  fi
  if [[ ! -f "$profiles_template" || ! -f "$model_settings_template" ]]; then
    print -u2 'The oMLX bootstrap templates are missing from local-ai configuration.'
    exit 1
  fi

  cp "$settings_file" "$settings_file.bootstrap-$timestamp.bak"
  temporary="$(mktemp "$omlx_dir/settings.json.bootstrap.XXXXXX")"
  jq --arg path "$model_dir" \
    '.model.model_dirs = [$path] | .model.model_dir = $path' \
    "$settings_file" > "$temporary"
  mv "$temporary" "$settings_file"

  for pair in "$profiles_file:$profiles_template" "$model_settings_file:$model_settings_template"; do
    local target="${pair%%:*}"
    local template="${pair#*:}"
    if [[ -f "$target" ]]; then
      cp "$target" "$target.bootstrap-$timestamp.bak"
      temporary="$(mktemp "$omlx_dir/$(basename "$target").bootstrap.XXXXXX")"
      jq -s '.[0] * .[1]' "$target" "$template" > "$temporary"
      mv "$temporary" "$target"
    else
      cp "$template" "$target"
    fi
  done

  print "Configured oMLX model directory: $model_dir"
  print "Backups use the suffix .bootstrap-$timestamp.bak under $omlx_dir"
  print 'Restart the service to apply the bootstrap: brew services restart jundot/omlx/omlx'
}

case "$action" in
  list)
    jq -r --arg provider "$provider" --arg model_dir "$model_dir" \
      '.models[] | select(.provider == $provider) | "\(.id)\t\(.tier)\t\(.role)\t\($model_dir)/\(.directory)\t\(.repository)"' \
      "$manifest"
    ;;
  download|dry-run)
    if [[ -z "$selection" ]]; then
      usage
      exit 2
    fi
    models="$(select_models "$selection")"
    if [[ -z "$models" ]]; then
      print -u2 "No models for '$selection' under provider '$provider'"
      exit 2
    fi
    while IFS= read -r model; do
      repository="$(jq -r '.repository' <<<"$model")"
      directory="$(jq -r '.directory' <<<"$model")"
      destination="$model_dir/$directory"
      command=(uvx hf download "$repository" --local-dir "$destination")
      if [[ "$action" == "dry-run" ]]; then
        command+=(--dry-run)
      fi
      print "→ $repository → $destination"
      "${command[@]}"
    done <<<"$models"
    ;;
  configure)
    if [[ -n "$selection" ]]; then
      usage
      exit 2
    fi
    case "$provider" in
      omlx) configure_omlx ;;
      *)
        print -u2 "Bootstrap is not implemented for provider: $provider"
        exit 2
        ;;
    esac
    ;;
  *)
    usage
    exit 2
    ;;
esac
