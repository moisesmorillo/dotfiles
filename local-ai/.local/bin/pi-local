#!/usr/bin/env zsh
# Run Pi against loopback-only oMLX without storing its API key in Pi or Git.
set -euo pipefail

typeset pi_source_dir="${LOCAL_AI_PI_CONFIG_DIR:-$HOME/.config/local-ai/pi}"
typeset pi_runtime_dir="${LOCAL_AI_PI_RUNTIME_DIR:-$HOME/.local/state/local-ai/pi}"
if [[ ! -f "$pi_source_dir/models.json" || ! -f "$pi_source_dir/settings.json" ]]; then
  print -u2 "Pi local configuration missing below: $pi_source_dir"
  exit 1
fi
mkdir -p "$pi_runtime_dir"
ln -sfn "$pi_source_dir/models.json" "$pi_runtime_dir/models.json"
ln -sfn "$pi_source_dir/settings.json" "$pi_runtime_dir/settings.json"
export LOCAL_OMLX_API_KEY="$(jq -r '.auth.api_key // empty' "$HOME/.omlx/settings.json")"
if [[ -z "$LOCAL_OMLX_API_KEY" ]]; then
  print -u2 'oMLX API key is not configured'
  exit 1
fi
exec env PI_CODING_AGENT_DIR="$pi_runtime_dir" PI_CODING_AGENT_SESSION_DIR="$pi_runtime_dir/sessions" PI_OFFLINE="${PI_OFFLINE:-1}" pi "$@"
